# ---- Database ----
DATABASE_URL="file:./meridian.db"

# ---- Auth ----
# 32+ char secret used to sign session JWTs. Generate: openssl rand -base64 48
AUTH_SECRET="meridian-development-secret-change-me-in-production-0123456789"
SESSION_TTL_HOURS=168

# ---- AI layer ----
# Optional. When unset, MERIDIAN uses the built-in deterministic reasoning
# engine, which derives every statement from workspace data (no fabrication).
ANTHROPIC_API_KEY=""
MERIDIAN_AI_MODEL="claude-opus-5"

# ---- Market data ----
# mock  -> MockMarketDataProvider (seeded, deterministic, clearly labelled)
MARKET_DATA_PROVIDER="mock"

# ---- Billing (architecture only, no charges are made) ----
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
